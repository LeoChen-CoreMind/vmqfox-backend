    "keywords": [
        "thinkphp",
        "payment-notification",
        "qrcode"
    ],
    "homepage": "https://github.com/LeoChen-CoreMind/vmqfox-backend",
    "license": "MIT",
    "authors": [
        {
            "name": "LeoChen-CoreMind",
            "homepage": "https://github.com/LeoChen-CoreMind"
        }
    ],
    "support": {
