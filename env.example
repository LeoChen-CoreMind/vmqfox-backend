APP_DEBUG = false
APP_TRACE = false
APP_FRONTEND_URL = http://localhost:3006
APP_TIMEZONE = Asia/Shanghai
ADMIN_USERNAME = replace-with-an-admin-username
ADMIN_PASSWORD = replace-with-a-long-random-password
SESSION_SECURE_COOKIE = false

# Binary names work when the tools are in PHP-FPM's PATH. Absolute paths are also supported.
QRCODE_ZBAR_BINARY = zbarimg
QRCODE_PYTHON_BINARY = python3
QRCODE_TESSERACT_BINARY = tesseract

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = vmq
USERNAME = vmqfox
PASSWORD = replace-with-a-random-password
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX =
DEBUG = false

[REDIS]
HOST = 127.0.0.1
PORT = 6379
PASSWORD =
SELECT = 0

[CACHE]
DRIVER = file

[SESSION]
DRIVER = file
